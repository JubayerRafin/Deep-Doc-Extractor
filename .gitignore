# ────────────────────────────────────────────────────────────────────
# Deep Doc Extractor — .gitignore
# ────────────────────────────────────────────────────────────────────

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.Python
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Pipeline outputs — too large to push, easy to regenerate
output/
chroma/
chroma_*/
**/qa_pairs.jsonl
**/qa_rejected.jsonl
**/augmented.jsonl
**/qa_pairs.csv
**/augmented.csv
**/dli_kb_snapshot.txt
**/mentor_batch.jsonl

# Allowed JSONL — only the small examples
!examples/*.jsonl
!results/*.jsonl

# Models — never commit (multi-GB)
*.gguf
*.bin
*.safetensors
.ollama/
~/.cache/

# Logs
*.log
nohup.out
ollama.log
stage*_run.log

# Source PDFs (too large for git; the team has them via shared drive)
*.pdf
!docs/**/*.pdf
!examples/sample_input.pdf
!docs/panel.pdf

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
/tmp/

# Secrets (just in case)
.env
*.key
secrets.yaml
